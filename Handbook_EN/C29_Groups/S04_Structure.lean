/- English edition source: Handbook/C29_Groups/S04_Structure.lean. -/
import Mathlib

namespace Handbook.C29

-- BOOK: begin cyclic-gen
-- A cyclic group: a group generated by a single element
#check @IsCyclic

-- a generator exists (the definition read backwards)
example (G : Type) [Group G] [IsCyclic G] :
    ∃ g : G, ∀ x : G, x ∈ Subgroup.zpowers g :=
  IsCyclic.exists_generator
-- BOOK: end cyclic-gen

-- BOOK: begin order-dvd
-- The order of an element divides the order of the group,
-- a corollary of Lagrange's theorem
example (G : Type) [Group G] [Fintype G] (g : G) :
    orderOf g ∣ Fintype.card G :=
  orderOf_dvd_card
-- BOOK: end order-dvd

-- BOOK: begin perm-sign
-- The symmetric group Equiv.Perm α is the group of all permutations of
-- α.
#check @Equiv.Perm

-- The sign is a homomorphism to {±1}, distinguishing even from odd
-- permutations.
#check @Equiv.Perm.sign

-- The alternating group is the kernel of the sign, hence always
-- a normal subgroup
#check @alternatingGroup
-- BOOK: end perm-sign

-- BOOK: begin solvable
-- A solvable group: one that decomposes into abelian layers
#check @IsSolvable

-- Symmetric groups of degree at least five are not solvable.
-- This is why there is no formula by radicals for general quintic
-- equations (Chapter 31).
#check @Equiv.Perm.not_solvable
-- BOOK: end solvable

-- BOOK: begin abelian-structure
-- Structure theorem for finite abelian groups: decompose into a direct
-- sum of cyclic groups of prime-power order.
#check @AddCommGroup.equiv_directSum_zmod_of_finite
-- BOOK: end abelian-structure

end Handbook.C29
