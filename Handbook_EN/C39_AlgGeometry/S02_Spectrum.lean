/- Chapter 39: Introduction to algebraic geometry
   39.3 The prime spectrum -/
import Mathlib

namespace Handbook.C39

-- BOOK: begin spectrum
-- The prime spectrum of a ring: prime ideals (Chapter 30) taken
-- as the "points" of a space
#check @PrimeSpectrum
-- it carries the Zariski topology
example (R : Type) [CommRing R] :
    TopologicalSpace (PrimeSpectrum R) :=
  inferInstance
-- BOOK: end spectrum

-- BOOK: begin spec-int
-- Points of Spec ℤ. The prime ideal generated by 2 is one point.
example : PrimeSpectrum ℤ :=
  ⟨Ideal.span {2}, by
    rw [Ideal.span_singleton_prime (by norm_num)]
    exact Int.prime_two⟩
-- the zero ideal is prime too (ℤ is a domain);
-- this is the generic point
example : PrimeSpectrum ℤ :=
  ⟨⊥, Ideal.isPrime_bot⟩
-- BOOK: end spec-int

-- BOOK: begin zero-locus
-- The zero locus: the prime ideals containing a given ideal.
-- This is the definition of a Zariski closed set.
#check @PrimeSpectrum.zeroLocus
-- the vanishing ideal, paired with the zero locus
#check @PrimeSpectrum.vanishingIdeal
-- BOOK: end zero-locus

-- BOOK: begin basic-open
-- The basic open set D(f): the points where f does not vanish.
-- These form a basis of the Zariski topology.
#check @PrimeSpectrum.basicOpen
-- the closure of a point is the zero locus of its prime ideal
example (R : Type) [CommRing R] (x : PrimeSpectrum R) :
    closure {x} = PrimeSpectrum.zeroLocus x.asIdeal :=
  PrimeSpectrum.closure_singleton x
-- BOOK: end basic-open

-- BOOK: begin comap
-- A ring map R →+* S induces Spec S → Spec R (the direction reverses)
example (R S : Type) [CommRing R] [CommRing S] (f : R →+* S) :
    PrimeSpectrum S → PrimeSpectrum R :=
  PrimeSpectrum.comap f
-- BOOK: end comap

-- BOOK: begin prime-vs-maximal
-- The preimage of a prime ideal is prime; this makes Spec a functor
example (R S : Type) [CommRing R] [CommRing S] (f : R →+* S)
    (p : Ideal S) [p.IsPrime] : (Ideal.comap f p).IsPrime := by
  infer_instance
-- it fails for maximal ideals. Along ℤ → ℚ the ideal (0) is maximal
-- in ℚ, but its preimage (0) is not maximal in ℤ
example : Ideal.comap (Int.castRingHom ℚ) (⊥ : Ideal ℚ) = ⊥ := by
  ext x
  simp [Ideal.mem_comap]
-- BOOK: end prime-vs-maximal

end Handbook.C39
